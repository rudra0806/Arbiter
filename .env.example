# ── Local model (Ollama) ─────────────────────────────────────────────────────
LOCAL_MODEL=qwen2.5:1.5b
LOCAL_NUM_PREDICT=512

# ── Hosted API model ─────────────────────────────────────────────────────────
# Supported providers: gemini | groq
PROVIDER=groq

# Gemini examples  : gemini-1.5-flash   gemini-2.0-flash
# Groq examples    : llama3-8b-8192     mixtral-8x7b-32768
API_MODEL=openai/gpt-oss-120b
API_MAX_OUTPUT_TOKENS=3072

# Your API key for the chosen provider (never commit this file!)
API_KEY=your_api_key_here

# ── Token cost (USD per million tokens) ──────────────────────────────────────
# Set both to 0.0 for free-tier providers.
# Gemini 1.5 Flash paid tier example: 0.075 / 0.30
COST_PER_M_IN=0.0
COST_PER_M_OUT=0.0
